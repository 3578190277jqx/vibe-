# Copy to .env; never commit real credentials. Node.js >= 24.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_KIND=sqlite
SQLITE_PATH=.local/aether.sqlite
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Production: DATABASE_KIND=postgres, NODE_ENV=production, verified TLS required.
DATABASE_URL=
DATABASE_SSL=require
# Optional PEM CA path for private database certificates.
DATABASE_CA_FILE=

# Default: direct socket IP; incoming forwarding headers are ignored.
# Configure ONLY after the actual reverse-proxy deployment route is known.
# Header must contain one valid IP overwritten by a trusted proxy, NOT an XFF chain.
CLIENT_IP_HEADER=
TRUSTED_PROXY_IPS=

# Integration tests: dedicated DB name must end with _test. Never use production.
TEST_DATABASE_URL=
